# ==========================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ==========================================
# Get these keys from your Midtrans MAP dashboard (Sandbox / Production)
# https://dashboard.sandbox.midtrans.com/
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ==========================================
# FIREBASE CLIENT CONFIGURATION
# ==========================================
# Project settings -> General -> Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mie-gacoan-selforder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mie-gacoan-selforder
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mie-gacoan-selforder.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# FIREBASE ADMIN SDK (SERVER ACTIONS & API)
# ==========================================
# Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=mie-gacoan-selforder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mie-gacoan-selforder.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==========================================
# DIOLEH2 ADMIN LOGIN (server-only secrets)
# ==========================================
# Choose a private username/password and a random secret with at least 32 chars.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Delivery coverage (Titik 0 Derajat Dieng coordinates)
STORE_LAT=-7.204176
STORE_LNG=109.911214
NEXT_PUBLIC_STORE_LAT=-7.204176
NEXT_PUBLIC_STORE_LNG=109.911214
# Local checkout demo only. Disable and use Firestore product/order records in production.
DEMO_CHECKOUT=false

# Optional WhatsApp Cloud API payment receipt; use an approved utility template
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_PAYMENT_TEMPLATE=order_payment_confirmed
WHATSAPP_TEMPLATE_LANGUAGE=id
